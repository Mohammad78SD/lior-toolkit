<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lior.printagent</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/Shared/lior-print-agent/print-agent.sh</string>
	</array>

	<!-- Run at login and then every 20 seconds. -->
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>20</integer>

	<key>StandardOutPath</key>
	<string>/Users/Shared/lior-print-agent/agent.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/Shared/lior-print-agent/agent.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
